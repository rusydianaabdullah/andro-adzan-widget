    <string name="notif_test_scheduled">Alarm set for 10 seconds from now. You can leave the app.</string>
    <string name="action_notif_test_now">Show now</string>
    <string name="action_notif_test_alarm">Test in 10s</string>
    <string name="action_open_notif_settings">Notification settings</string>
    <string name="action_open_battery_settings">Battery settings</string>
    <string name="notif_test_battery_hint">Tapping this opens Android\'s own battery exemption dialog, but many phones (Xiaomi, Oppo, Vivo, Samsung, OnePlus, and others) have a second, separate setting the app can\'t open for you — often called \"No restrictions\", \"Allow background activity\", or \"Autostart\", under the app\'s own Battery or Battery usage page in system Settings. Set that too, or the adzan can still be delayed or skipped during long sleep.</string>
