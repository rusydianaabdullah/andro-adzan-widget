    <string name="notif_test_exact">Exact alarms</string>
    <string name="notif_test_exact_why">Without this, Android may fire the alarm a few minutes late — or defer it further during deep sleep.</string>
    <string name="notif_test_battery">Battery unrestricted</string>
    <string name="notif_test_battery_why">Some phones freeze or delay background apps during long sleep unless this is granted, which is the most common reason an adzan gets missed.</string>
